# Anthropic API key (required for AI auto-trader)
ANTHROPIC_API_KEY=sk-ant-...

# Admin authentication (required for write/admin endpoints)
# Generate the password hash with: python backend/scripts/hash_password.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$replace-with-output-of-hash_password.py
JWT_SECRET=replace-with-a-long-random-secret

# Telegram (required for Mirroly Live listener)
# Get API ID/Hash from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_CHANNEL=MirrorlyLive

# SSL CA certificate (for Cloudflare WARP or corporate proxy)
# Not needed on servers without proxy
#SSL_CERT_FILE=~/.config/certs/cloudflare-warp.pem
#REQUESTS_CA_BUNDLE=${SSL_CERT_FILE}
#NODE_EXTRA_CA_CERTS=${SSL_CERT_FILE}

# Public domain for Caddy reverse proxy (automatic HTTPS via Let's Encrypt).
# Use your DuckDNS subdomain, e.g. yourname.duckdns.org
# Local docker test without a domain: set to localhost (Caddy uses its internal CA).
DOMAIN=<your-subdomain>.duckdns.org

# Backend API URL (used by docker-compose as NEXT_PUBLIC_API_URL build arg)
# Behind Caddy (same-origin): set to the domain root; Caddy routes /api/* to the backend.
#   e.g. https://yourname.duckdns.org
# Local dev (no Caddy): defaults to http://localhost:8000
API_URL=https://<your-subdomain>.duckdns.org

# CORS allowed origins (comma-separated). Defaults to http://localhost:3000.
# Behind Caddy the frontend is same-origin, so this is mostly a safety net.
# Set to the deployed domain, e.g. https://yourname.duckdns.org
ALLOWED_ORIGINS=https://<your-subdomain>.duckdns.org
